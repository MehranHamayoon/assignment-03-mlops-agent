FROM python:3.12-slim
WORKDIR /opt/project
RUN pip install --no-cache-dir fastapi==0.162.1 uvicorn==0.54.0 \
    numpy==2.5.4 pandas==2.3.3 scikit-learn==1.9.1 PyYAML==6.0.3
COPY api api
COPY training training
COPY artifacts/approved/model.json /opt/model/model.json
RUN useradd --uid 10001 --create-home app
USER 10001
ENV MODEL_PATH=/opt/model/model.json
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

